
<!--// ### start MainWindow.xaml ###-->

    <Window x:Class="Sniper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sniper"
        mc:Ignorable="d"
        Title="Sniper Trading Bot" Height="580" Width="750"
        Background="#1E1E1E" ResizeMode="CanResize">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="🎯 SNIPER TRADING BOT" Foreground="#00FF88"
                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Статистика и Баланс в реальном времени -->
        <Grid Grid.Row="1" Margin="0,0,0,10" Background="#2D2D2D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Текущая позиция -->
            <Border Grid.Column="0" Background="#333333" Margin="2" CornerRadius="4">
                <StackPanel Margin="8">
                    <TextBlock Text="ПОЗИЦИЯ" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="PositionStatus" Text="Нет" Foreground="Yellow" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="PositionDetails" Text="Ожидание сигнала" Foreground="White" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Прибыль / Убыток (PnL) -->
            <Border Grid.Column="1" Background="#333333" Margin="2" CornerRadius="4">
                <StackPanel Margin="8">
                    <TextBlock Text="ПРИБЫЛЬ / УБЫТОК" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="PnLText" Text="0.00 USDT" Foreground="#00FF00" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="PnLPercent" Text="0.00%" Foreground="#00FF00" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Баланс на бирже -->
            <Border Grid.Column="2" Background="#333333" Margin="2" CornerRadius="4">
                <StackPanel Margin="8">
                    <TextBlock Text="БАЛАНС BYBIT" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="BalanceText" Text="0.00 USDT" Foreground="Cyan" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="BalanceChange" Text="Связь проверяется..." Foreground="White" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Статистика Бэктеста -->
            <Border Grid.Column="3" Background="#333333" Margin="2" CornerRadius="4">
                <StackPanel Margin="8">
                    <TextBlock Text="СТАТИСТИКА БЭКТЕСТА" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="StatsText" Text="Сигналов: 0 | Сделок: 0" Foreground="White" FontSize="11"/>
                    <TextBlock x:Name="WinRateText" Text="WinRate: 0%" Foreground="#00FF00" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Логи работы -->
        <TextBox x:Name="LogTextBox" Grid.Row="2" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" Background="#2D2D2D"
                 Foreground="#00FF00" FontFamily="Consolas" FontSize="12" Padding="8"
                 Margin="0,0,0,10" TextWrapping="Wrap"/>

        <!-- Кнопки управления -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusLabel" Text="Цикл мониторинга остановлен" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="5,0"/>
            <Button x:Name="StopBtn" Grid.Column="1" Content="■ СТОП" Background="#FF4444" Foreground="White" FontWeight="Bold" Width="110" Height="35" Margin="5" Click="StopBtn_Click" IsEnabled="False"/>
            <Button x:Name="RestartBtn" Grid.Column="2" Content="► ПЕРЕЗАПУСК" Background="#f39c12" Foreground="White" FontWeight="Bold" Width="110" Height="35" Margin="5" Click="RestartBtn_Click" IsEnabled="False"/>
            <Button x:Name="StartBtn" Grid.Column="3" Content="▲ ЗАПУСТИТЬ" Background="#2ecc71" Foreground="White" FontWeight="Bold" Width="110" Height="35" Margin="5" Click="StartBtn_Click"/>
        </Grid>
    </Grid>
</Window>
    
<!--// ### end MainWindow.xaml ###-->

